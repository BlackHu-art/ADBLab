{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ADBLab: Run App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "ADBLab: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "QT_QPA_PLATFORM": "offscreen"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
