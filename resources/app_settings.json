{
  "schema_version": 3,
  "font_family": "Microsoft YaHei",
  "ui_font_size": 12,
  "log_font_size": 10,
  "save_directory": "",
  "log_max_lines": 2000,
  "confirm_dangerous_ops": true,
  "continuous_device_scan": true,
  "device_scan_interval_ms": 15000,
  "always_on_top": false,
  "performance_log_threshold_ms": 300,
  "monkey_params": {
    "events": 10000,
    "throttle": 300,
    "ignore_crashes": true,
    "ignore_timeouts": true,
    "ignore_security": true,
    "touch": 30,
    "motion": 15,
    "trackball": 0,
    "nav": 20,
    "majornav": 10,
    "syskeys": 5,
    "appswitch": 8,
    "anyevent": 10,
    "pinch": 2
  },
  "theme": "Light",
  "window_width": 1200,
  "window_height": 750,
  "panel_split_ratio": 0.4,
  "device_log_split_ratio": 0.6,
  "scrcpy_preset": "Smooth",
  "scrcpy_maxsize": "1024",
  "scrcpy_fps": "30",
  "scrcpy_codec": "h264",
  "scrcpy_buffer": "50",
  "scrcpy_bitrate": "4",
  "scrcpy_orientation": "0"
}
