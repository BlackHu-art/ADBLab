"""验证性能采集参数复用、归档与停止关闭边界，不执行设备命令。"""

from copy import deepcopy
from pathlib import Path

import pytest
from PySide6.QtCore import QObject, Signal

from gui.dialogs.fluent_dialog import FluentMessageBox
from gui.dialogs.performance_launcher import PerformancePage
from services.run_library import RunPreset


class _Library(QObject):
    changed = Signal()
    error = Signal(str)

    def __init__(self):
        super().__init__()
        self.records = ()
        self.presets = ()

    def record_run(self, record):
        self.records += (record,)
        self.changed.emit()

    def save_preset(self, name, kind, parameters):
        self.presets += (RunPreset("demo-preset", name, kind, deepcopy(parameters), 1.0),)
        self.changed.emit()


class _Runner:
    def __init__(self):
        self.running = False
        self.last_config = None
        self.last_exit_code = None
        self.result_dir = ""
        self.report_file = ""
        self.started = 0
        self.stop_calls = 0
        self.start_error = ""

    def is_running(self):
        return self.running

    def start(self, config, **_callbacks):
        self.started += 1
        self.last_config = deepcopy(config)
        if self.start_error:
            raise RuntimeError(self.start_error)
        self.running = True

    def stop(self):
        self.stop_calls += 1
        self.running = False
        self.last_exit_code = 0

    def request_stop(self):
        self.stop_calls += 1

    def latest_result_dir(self):
        return self.result_dir

    def latest_report_file(self):
        return self.report_file


@pytest.fixture
def page(qt_application, tmp_path):
    window = PerformancePage("demo-current-device", "com.example.demo")
    window.save_path_edit.setText(str(tmp_path / "output"))
    window._runner = _Runner()
    window.set_run_library(_Library())
    yield window
    window._runner.running = False
    if window._stop_thread is not None:
        window._stop_thread.join(1)
    window.request_dispose("test")
    window.close()
    qt_application.processEvents()


def _finish(page, tmp_path, *, exit_code=0, report=True, result=True):
    runner = page._runner
    if result:
        target = tmp_path / "finished"
        target.mkdir(exist_ok=True)
        runner.result_dir = str(target)
        if report:
            output = target / "summary_demo.xlsx"
            output.write_bytes(b"demo-report")
            runner.report_file = str(output)
    runner.running = False
    runner.last_exit_code = exit_code
    page._mark_runner_finished()
    return page._library_controller._library.records


def test_performance_parameters_round_trip_without_device_binding_or_start(page):
    page.monkey_check.setChecked(True)
    page.frequency_input.setValue(7)
    page.timeout_input.setValue(23)
    page.dumpheap_input.setValue(11)
    page.monkey_throttle_combo.setValue(777)
    page.monkey_seed_edit.setValue(42)
    page.monkey_ignore_crashes.setChecked(False)
    page.monkey_kill_after_error.setChecked(False)
    page.exception_edit.setText("fatal exception;custom-error")
    page.phone_log_edit.setText("/data/anr;/data/local/tmp/demo")
    page.monkey_pct_combos["pct_touch"].setValue(45)
    parameters = page.capture_run_parameters()
    assert parameters["schema_version"] == 1
    assert "device_id" not in parameters and "mailbox" not in parameters
    assert Path(parameters["save_path"]).name != page._device_tag()
    page.frequency_input.setValue(1)
    page.monkey_check.setChecked(False)
    page.apply_run_parameters(parameters)
    assert page.capture_run_parameters() == parameters
    assert page.device_ip == "demo-current-device"
    assert page._runner.started == 0
    assert page.build_config().device_id == "demo-current-device"
    assert Path(page.build_config().save_path).name == page._device_tag()


def test_history_activation_loads_parameters_but_does_not_rebind_or_start(page):
    parameters = page.capture_run_parameters()
    parameters.update(package="com.example.previous", device_id="must-not-become-target")
    page.activate({"run_parameters": parameters})
    assert page.package_edit.text() == "com.example.previous"
    assert page.device_ip == "demo-current-device"
    assert page._runner.started == 0


def test_named_preset_bar_saves_and_loads_full_parameters_without_start(page, monkeypatch):
    from gui.widgets.run_preset_bar import FluentInputDialog

    monkeypatch.setattr(FluentInputDialog, "getText", lambda *_args, **_kwargs: ("演示方案", True))
    page.frequency_input.setValue(9)
    page.monkey_check.setChecked(True)
    page.monkey_seed_edit.setValue(12345)
    page.run_preset_bar.save_button.click()
    saved, = page._library_controller._library.presets
    assert saved.name == "演示方案" and saved.kind == "performance"
    assert "device_id" not in saved.parameters
    page.frequency_input.setValue(1)
    page.monkey_seed_edit.setValue(1)
    page.run_preset_bar.load_button.click()
    assert page.frequency_input.value() == 9
    assert page.monkey_seed_edit.value() == 12345
    assert page._runner.started == 0


def test_invalid_form_does_not_create_a_run_or_a_preset_snapshot(page, monkeypatch):
    monkeypatch.setattr(FluentMessageBox, "warning", lambda *_args: None)
    page.frequency_input.setText("0")
    assert page.capture_run_parameters() is None
    page.start_mobileperf()
    assert page._runner.started == 0
    assert page._library_controller._library.records == ()


@pytest.mark.parametrize("busy_state", ["running", "stopping", "closing"])
def test_busy_performance_rejects_history_parameters_atomically(page, busy_state):
    before = page.capture_run_parameters()
    modified = deepcopy(before)
    modified.update(package="com.example.other", frequency_seconds=9)
    if busy_state == "running":
        page.start_mobileperf()
    elif busy_state == "stopping":
        page._stopping = True
    else:
        page._closing = True
    page.apply_run_parameters(modified)
    assert page.package_edit.text() == before["package"]
    assert page.frequency_input.value() == before["frequency_seconds"]
    if busy_state == "closing":
        page._closing = False


@pytest.mark.parametrize("invalid", [
    {"frequency_seconds": 0}, {"timeout_minutes": True},
    {"monkey_config": {"pct_touch": 101}}, {"phone_log_paths": "not-a-list"},
    {"monkey_enabled": "yes"}, {"schema_version": 2},
])
def test_invalid_parameters_leave_every_field_unchanged(page, monkeypatch, invalid):
    messages = []
    monkeypatch.setattr(FluentMessageBox, "warning", lambda *_args: messages.append(True))
    before = page.capture_run_parameters()
    changed = {**deepcopy(before), "package": "com.example.other", **invalid}
    page.apply_run_parameters(changed)
    assert messages and page.capture_run_parameters() == before


def test_natural_completion_records_effective_snapshot_and_artifacts_once(page, tmp_path):
    page.setProperty("run_device_label", "演示手机 A")
    page.frequency_input.setValue(3)
    page.start_mobileperf()
    page.setProperty("run_device_label", "后续设备型号")
    page.package_edit.setText("com.example.edited")
    page.frequency_input.setValue(9)
    records = _finish(page, tmp_path)
    page._mark_runner_finished()
    page._poll_runner()
    assert len(records) == len(page._library_controller._library.records) == 1
    record = records[0]
    assert record.kind == "performance" and record.state == "succeeded"
    assert record.package_name == "com.example.demo"
    assert record.parameters["frequency_seconds"] == 3
    assert record.started_at <= record.finished_at
    assert record.app_version == ""
    assert record.device_label == "演示手机 A"
    assert {Path(item.path).name for item in record.artifacts} == {"finished", "summary_demo.xlsx"}


def test_failed_start_records_no_stale_previous_artifacts(page, tmp_path):
    old = tmp_path / "old"
    old.mkdir()
    stale = old / "summary_old.xlsx"
    stale.write_bytes(b"previous")
    page._runner.result_dir = str(old)
    page._runner.report_file = str(stale)
    page._runner.start_error = "synthetic start failure"
    page.start_mobileperf()
    record, = page._library_controller._library.records
    assert record.state == "failed" and record.artifacts == ()
    assert "synthetic start failure" not in record.message
    assert "运行日志" in record.message
    page._mark_runner_finished()
    assert len(page._library_controller._library.records) == 1


def test_empty_start_exception_still_archives_failed_without_artifacts(page, monkeypatch):
    def fail(*_args, **_kwargs):
        raise RuntimeError()

    monkeypatch.setattr(page._runner, "start", fail)
    page.start_mobileperf()
    record, = page._library_controller._library.records
    assert record.state == "failed" and record.artifacts == ()


def test_empty_report_file_cannot_mark_a_run_successful(page, tmp_path):
    page.start_mobileperf()
    target = tmp_path / "incomplete"
    target.mkdir()
    report = target / "summary.xlsx"
    report.touch()
    runner = page._runner
    runner.result_dir, runner.report_file = str(target), str(report)
    runner.last_exit_code, runner.running = 0, False
    page.archive_finished_run()
    record, = page._library_controller._library.records
    assert record.state == "partial"
    assert [artifact.path for artifact in record.artifacts] == [str(target)]


@pytest.mark.parametrize("closing", [False, True])
@pytest.mark.parametrize("unavailable, expected_artifacts, expected_state", [
    (("latest_result_dir",), {"summary.xlsx"}, "partial"),
    (("latest_report_file",), {"finished"}, "partial"),
    (("latest_result_dir", "latest_report_file"), set(), "failed"),
])
def test_attachment_lookup_errors_preserve_parameters_and_do_not_escape_archive(
    page, tmp_path, monkeypatch, closing, unavailable, expected_artifacts, expected_state,
):
    parameters = page.capture_run_parameters()
    page.start_mobileperf()
    target = tmp_path / "finished"
    target.mkdir()
    report = target / "summary.xlsx"
    report.write_bytes(b"report")
    runner = page._runner
    runner.result_dir, runner.report_file = str(target), str(report)
    runner.running, runner.last_exit_code = False, 0

    def unavailable_output():
        raise PermissionError("synthetic private output path")

    for name in unavailable:
        monkeypatch.setattr(runner, name, unavailable_output)
    if closing:
        page._closing = True
        page._library_controller.request_cancel()
        page.archive_finished_run()
    else:
        page._mark_runner_finished()
        assert not page._configuration_locked
        assert page.start_btn.isEnabled() and not page.stop_btn.isEnabled()
        assert not page._poll_timer.isActive()
        assert page._status_state == "warning"
        assert page.progress_bar.value() < 100
    page.archive_finished_run()
    record, = page._library_controller._library.records
    assert record.state == expected_state
    assert record.parameters == parameters
    assert record.package_name == "com.example.demo"
    assert {Path(artifact.path).name for artifact in record.artifacts} == expected_artifacts
    assert "synthetic private output path" not in record.message
    page._closing = False


def test_report_stat_error_during_dispose_still_emits_ready_with_incomplete_record(
    page, tmp_path, monkeypatch,
):
    page.start_mobileperf()
    target = tmp_path / "finished"
    target.mkdir()
    report = target / "summary.xlsx"
    report.write_bytes(b"report")
    runner = page._runner
    runner.result_dir, runner.report_file = str(target), str(report)
    runner.running, runner.last_exit_code = False, 0

    def unavailable_size(_path):
        raise OSError("synthetic output unavailable")

    monkeypatch.setattr("gui.dialogs.performance_library.os.path.getsize", unavailable_size)
    seen = []
    page.dispose_ready.connect(
        lambda *_args: seen.append(page._library_controller._library.records)
    )
    page._shutdown_registered = True
    page.request_dispose("application_close")
    assert len(seen) == 1
    record, = seen[0]
    assert record.state == "partial"
    assert [artifact.path for artifact in record.artifacts] == [str(target)]


@pytest.mark.parametrize("exit_code, report, result, expected", [
    (5, True, True, "partial"), (0, False, True, "partial"),
    (5, False, False, "failed"), (0, False, False, "failed"),
])
def test_incomplete_or_failed_runs_never_archive_as_success(
    page, tmp_path, exit_code, report, result, expected,
):
    page.start_mobileperf()
    record, = _finish(page, tmp_path, exit_code=exit_code, report=report, result=result)
    assert record.state == expected


def test_stop_waits_for_exit_then_archives_cancelled_once(page, qt_application, tmp_path):
    page.start_mobileperf()
    page.stop_mobileperf()
    page._stop_thread.join(1)
    qt_application.processEvents()
    page._mark_runner_finished()
    record, = page._library_controller._library.records
    assert record.state == "cancelled"
    page._poll_runner()
    assert len(page._library_controller._library.records) == 1


def test_failed_stop_keeps_active_record_until_actual_exit(page, tmp_path):
    page.start_mobileperf()
    page._library_controller.request_cancel()
    page._stopping = True
    page._mark_runner_finished()
    assert page._library_controller._library.records == ()
    assert page._configuration_locked
    record, = _finish(page, tmp_path)
    assert record.state == "cancelled" and record.artifacts


@pytest.mark.parametrize("already_ended", [False, True])
def test_dispose_records_before_ready_signal_even_when_completion_callback_is_late(
    page, tmp_path, already_ended,
):
    page.start_mobileperf()
    runner = page._runner
    seen = []
    page.dispose_ready.connect(
        lambda *_args: seen.append(page._library_controller._library.records)
    )
    page._shutdown_registered = True
    if already_ended:
        runner.running = False
        runner.last_exit_code = 0
        target = tmp_path / "completed"
        target.mkdir()
        report = target / "summary.xlsx"
        report.write_bytes(b"complete")
        runner.result_dir, runner.report_file = str(target), str(report)
    page.request_dispose("application_close")
    if not already_ended:
        assert seen == [] and page._library_controller._library.records == ()
        runner.running = False
        runner.last_exit_code = 0
        page._poll_dispose_ready()
    assert len(seen) == 1 and len(seen[0]) == 1
    assert seen[0][0].state == ("succeeded" if already_ended else "cancelled")


def test_repeated_runs_have_distinct_ids_and_snapshots(page, tmp_path):
    page.start_mobileperf()
    _finish(page, tmp_path)
    page.package_edit.setText("com.example.second")
    page.start_mobileperf()
    records = _finish(page, tmp_path)
    assert len(records) == 2 and records[0].run_id != records[1].run_id
    assert [record.package_name for record in records] == ["com.example.demo", "com.example.second"]
